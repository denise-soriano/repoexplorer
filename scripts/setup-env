#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly PROJECT_ROOT
readonly ENV_TEMPLATE="${PROJECT_ROOT}/.env.example"
readonly ENV_FILE="${PROJECT_ROOT}/.env"

if [[ -e "${ENV_FILE}" ]]; then
    echo "Refusing to overwrite existing ${ENV_FILE}." >&2
    exit 1
fi

if [[ ! -f "${ENV_TEMPLATE}" ]]; then
    echo "Environment template not found: ${ENV_TEMPLATE}" >&2
    exit 1
fi

if ! command -v openssl >/dev/null 2>&1; then
    echo 'openssl is required to generate database passwords.' >&2
    exit 1
fi

if ! ADMIN_PASSWORD="$(openssl rand -hex 32)"; then
    echo 'Failed to generate the PostgreSQL administrator password.' >&2
    exit 1
fi
if ! APPLICATION_PASSWORD="$(openssl rand -hex 32)"; then
    echo 'Failed to generate the PostgreSQL application password.' >&2
    exit 1
fi
while [[ "${APPLICATION_PASSWORD}" == "${ADMIN_PASSWORD}" ]]; do
    APPLICATION_PASSWORD="$(openssl rand -hex 32)"
done
readonly ADMIN_PASSWORD APPLICATION_PASSWORD

umask 077
set -o noclobber
TEMP_DIR="$(mktemp -d "${PROJECT_ROOT}/.env.tmp.XXXXXX")"
readonly TEMP_DIR
TEMP_FILE="${TEMP_DIR}/.env"
readonly TEMP_FILE
trap 'rm -rf -- "${TEMP_DIR}"' EXIT

if ! sed \
    -e "s/CHANGE_ME_TO_A_RANDOM_ADMIN_PASSWORD/${ADMIN_PASSWORD}/" \
    -e "s/CHANGE_ME_TO_A_DIFFERENT_RANDOM_APP_PASSWORD/${APPLICATION_PASSWORD}/" \
    "${ENV_TEMPLATE}" >"${TEMP_FILE}"; then
    echo 'Failed to write the generated environment file.' >&2
    exit 1
fi

if grep -q 'CHANGE_ME_' "${TEMP_FILE}"; then
    echo "Environment template contains an unfilled placeholder: ${ENV_TEMPLATE}" >&2
    exit 1
fi

if ! ln "${TEMP_FILE}" "${ENV_FILE}" 2>/dev/null; then
    echo "Refusing to overwrite existing ${ENV_FILE}." >&2
    exit 1
fi

echo "Created ${ENV_FILE} with separate random database passwords."
